{
  "manifest_version": 3,
  "name": "Mentora — CRM Vinted privé",
  "version": "0.1.1",
  "description": "Lecture des commandes visibles dans un unique onglet dédié. Version bêta à vérifier sur votre compte.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://mentora-resell.vercel.app/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Mentora CRM" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/*"],
      "js": ["reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
