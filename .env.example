# PostgreSQL dédié à Relais. Requis sur Vercel ; SQLite est utilisé en local.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Web Push: generate once with node scripts/generate-vapid.mjs.
# Configure in Vercel Production. Never prefix the private key with NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mentora.officiel@gmail.com

# Annonces Discord (serveur uniquement). Automatique désactivé en base par défaut.
DISCORD_CHANGELOG_WEBHOOK_URL=
# Facultatif, pour augmenter le quota de lecture du dépôt GitHub.
CHANGELOG_GITHUB_TOKEN=
